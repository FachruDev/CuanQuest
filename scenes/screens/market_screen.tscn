[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/screens/market_screen.gd" id="1_market"]
[ext_resource type="Script" path="res://scripts/ui/price_chart.gd" id="2_chart"]

[node name="MarketScreen" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
