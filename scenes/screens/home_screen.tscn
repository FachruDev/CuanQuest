[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/screens/home_screen.gd" id="1_home"]
[ext_resource type="Theme" path="res://theme/senja_theme.tres" id="2_theme"]

[node name="HomeScreen" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
theme_override_constants/separation = 14
script = ExtResource("1_home")

[node name="Segments" type="PanelContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SegmentTrack"

[node name="Row" type="HBoxContainer" parent="Segments"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Scroll" type="ScrollContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/scrollbar_h_separation = 12
horizontal_scroll_mode = 0

[node name="Pages" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Today" type="VBoxContainer" parent="Scroll/Pages"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 14

[node name="Money" type="VBoxContainer" parent="Scroll/Pages"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 14

[node name="Life" type="VBoxContainer" parent="Scroll/Pages"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 14
