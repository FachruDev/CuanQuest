[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/screens/home_screen.gd" id="1_home"]
[ext_resource type="Theme" path="res://theme/senja_theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://assets/icons/heart.svg" id="3_heart"]
