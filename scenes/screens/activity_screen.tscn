[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/screens/activity_screen.gd" id="1_activity"]
[ext_resource type="Theme" path="res://theme/senja_theme.tres" id="2_theme"]

[node name="ActivityScreen" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
theme_override_constants/separation = 12
script = ExtResource("1_activity")

[node name="Segments" type="PanelContainer" parent="."]
