[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/screens/assets_screen.gd" id="1_assets"]
[ext_resource type="Theme" path="res://theme/senja_theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://assets/icons/chevron_left.svg" id="3_back"]

[node name="AssetsScreen" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
theme_override_constants/separation = 14
script = ExtResource("1_assets")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="BackButton" type="Button" parent="Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(62, 66)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "NG_BACK"
theme_type_variation = &"RoundButton"
icon = ExtResource("3_back")
icon_alignment = 1

[node name="TitleBox" type="VBoxContainer" parent="Header"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 0

[node name="Title" type="Label" parent="Header/TitleBox"]
layout_mode = 2
theme_type_variation = &"DetailTitleLabel"
text = "ASSETS_TITLE"

[node name="Summary" type="Label" parent="Header/TitleBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_type_variation = &"SmallMutedLabel"
autowrap_mode = 3

[node name="Segments" type="PanelContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SegmentTrack"

[node name="Row" type="HBoxContainer" parent="Segments"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Scroll" type="ScrollContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/scrollbar_h_separation = 12
horizontal_scroll_mode = 0

[node name="Page" type="VBoxContainer" parent="Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14
